{
  "name": "@level-zero/web",
  "version": "0.0.0",
  "private": true,
  "description": "Workbench web client.",
  "scripts": {
    "build": "next build",
    "dev": "next dev --port ${WEB_PORT:-3000}",
    "start": "next start --port ${WEB_PORT:-3000}",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf .next dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@level-zero/config": "workspace:*",
    "@level-zero/domain": "workspace:*",
    "@level-zero/ui": "workspace:*",
    "@tanstack/react-query": "^5.90.2",
    "@tiptap/core": "^3.31.3",
    "@tiptap/pm": "^3.31.3",
    "@tiptap/react": "^3.31.3",
    "@tiptap/suggestion": "^3.31.3",
    "next": "^16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^28.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vitest": "^5.0.0"
  }
}
