{
  "name": "@level-zero/api",
  "version": "0.0.0",
  "private": true,
  "description": "Level Zero API - modular monolith over the shared domain packages.",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@level-zero/ai": "workspace:*",
    "@level-zero/config": "workspace:*",
    "@level-zero/database": "workspace:*",
    "@level-zero/domain": "workspace:*",
    "@nestjs/common": "^12.0.0",
    "@nestjs/core": "^12.0.0",
    "@nestjs/platform-express": "^12.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.0",
    "@swc/core": "^1.16.2",
    "@types/express": "^5.0.0",
    "@types/node": "^22.15.0",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.1.1",
    "typescript": "~5.9.3",
    "unplugin-swc": "^1.6.0",
    "vitest": "^5.0.0"
  }
}
