{
  "name": "@level-zero/worker",
  "version": "0.0.0",
  "private": true,
  "description": "Background worker. Independently executable, shares the domain packages with the API.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@level-zero/ai": "workspace:*",
    "@level-zero/config": "workspace:*",
    "@level-zero/database": "workspace:*",
    "@level-zero/domain": "workspace:*",
    "@level-zero/storage": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0"
  }
}
