{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    // `nodenext`, not `node16`: NestJS 12 is ESM-only (`"type": "module"`, no
    // CommonJS build), and `apps/api` compiles to CommonJS because Nest's
    // constructor injection needs `emitDecoratorMetadata`. Only `nodenext`
    // models Node's `require()` of ESM, which is what makes that pairing legal
    // — under `node16` every `@nestjs/*` import is a TS1479 error. Node >=22.12
    // (see the root `engines`) is what supports it at runtime.
    "module": "nodenext",
    "moduleResolution": "nodenext",
    // No `types` default here on purpose. TypeScript 6 dropped automatic
    // inclusion of `node_modules/@types`, so every config that wants ambient
    // globals — Node's `process`/`Buffer`/`node:*`, Vitest's bare `describe` —
    // has to name them. `types` does not merge with an extended config, it
    // replaces it, so a default set here would vanish silently from any
    // workspace that declared a `types` of its own. Each workspace lists its
    // own. Types reached through an import (`@types/pg` behind `pg`) are
    // unaffected and must not be listed.
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "incremental": true
  },
  "exclude": ["node_modules", "dist", ".next", ".turbo"]
}
