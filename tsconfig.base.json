{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    // `nodenext`, not `node16`: NestJS 12 is ESM-only (`"type": "module"`, no
    // CommonJS build), and `apps/api` compiles to CommonJS because Nest's
    // constructor injection needs `emitDecoratorMetadata`. Only `nodenext`
    // models Node's `require()` of ESM, which is what makes that pairing legal
    // — under `node16` every `@nestjs/*` import is a TS1479 error. Node >=22.12
    // (see the root `engines`) is what supports it at runtime.
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "incremental": true
  },
  "exclude": ["node_modules", "dist", ".next", ".turbo"]
}
