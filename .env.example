# Copy to .env and adjust for your machine: cp .env.example .env
# Everything below is read and validated by @level-zero/config at startup.

NODE_ENV=development
LOG_LEVEL=info

# --- Postgres -------------------------------------------------------------
# Matches the defaults in infra/docker-compose.yml.
POSTGRES_USER=level_zero
POSTGRES_PASSWORD=level_zero
POSTGRES_DB=level_zero
POSTGRES_PORT=5432
DATABASE_URL=postgresql://level_zero:level_zero@localhost:5432/level_zero

# --- Redis ----------------------------------------------------------------
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# --- Apps -----------------------------------------------------------------
API_PORT=3001
WEB_PORT=3000
WORKER_PORT=3002

# Origins allowed to call the API (comma separated).
API_CORS_ORIGINS=http://localhost:3000

# Directory local asset bytes are written under (see @level-zero/storage).
STORAGE_LOCAL_ROOT=./.data/assets

# --- AI providers ---------------------------------------------------------
# Enables the Anthropic adapter for text capabilities in the worker. Leave it
# unset and the echo provider stands in, so local development still runs.
# ANTHROPIC_API_KEY=

# Public API base URL used by the browser.
NEXT_PUBLIC_API_URL=http://localhost:3001
