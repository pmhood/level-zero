# The API: the modular monolith over the shared domain packages.
#
# Also the image the migration Job runs, because the migrations ship inside it
# (packages/database/migrations) and the compiled runner sits next to them.
#
# Three stages, and the split is the point. `manifests` holds only the
# package.json files, so a source edit does not invalidate the dependency
# install. `build` is the full workspace with dev dependencies. `prod-deps` is
# a second, independent install of production dependencies only — cheaper and
# far more predictable than pruning the dev tree, which under pnpm means
# reasoning about a symlink farm.
FROM node:24-slim AS base
ENV PNPM_HOME=/pnpm \
    PATH=/pnpm:$PATH \
    COREPACK_ENABLE_DOWNLOAD_PROMPT=0
# Corepack takes the version from package.json's `packageManager`, so the image
# builds with exactly the pnpm the lockfile was written by.
RUN corepack enable
WORKDIR /app

# ---------------------------------------------------------------------------
FROM base AS manifests

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc turbo.json tsconfig.base.json ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY apps/worker/package.json apps/worker/
COPY packages/ai/package.json packages/ai/
COPY packages/config/package.json packages/config/
COPY packages/database/package.json packages/database/
COPY packages/domain/package.json packages/domain/
COPY packages/storage/package.json packages/storage/
COPY packages/ui/package.json packages/ui/

# ---------------------------------------------------------------------------
FROM manifests AS build

RUN pnpm install --frozen-lockfile
COPY . .
# Turbo's `build` dependsOn ^build, so this also builds config, domain,
# database, ai and storage in dependency order. Never bypass it: packages/domain
# is consumed as compiled output, and a stale dist fails as silent field
# dropping rather than as a build error.
RUN pnpm turbo run build --filter=@level-zero/api

# ---------------------------------------------------------------------------
FROM manifests AS prod-deps

# `...` includes the workspace dependencies of the API, so the tree is exactly
# what the runtime resolves and nothing more.
RUN pnpm install --frozen-lockfile --prod --filter "@level-zero/api..."

# ---------------------------------------------------------------------------
FROM base AS runtime

ENV NODE_ENV=production \
    API_PORT=3001

# The manifests and the production symlink farm, then the compiled output laid
# over it. pnpm's links are relative, so the layout has to match the install —
# hence the identical /app WORKDIR in every stage.
COPY --from=prod-deps /app ./
COPY --from=build /app/packages/config/dist packages/config/dist
COPY --from=build /app/packages/domain/dist packages/domain/dist
COPY --from=build /app/packages/database/dist packages/database/dist
COPY --from=build /app/packages/storage/dist packages/storage/dist
COPY --from=build /app/packages/ai/dist packages/ai/dist
COPY --from=build /app/apps/api/dist apps/api/dist
# Plain SQL, applied by packages/database/dist/scripts/migrate.js, which
# resolves this folder relative to its own location.
COPY --from=build /app/packages/database/migrations packages/database/migrations

USER node
EXPOSE 3001

# Liveness only. /api/health/ready consults Postgres and Redis and answers 503
# while either is down, which is what a rollout should gate on but not what
# should restart a container.
HEALTHCHECK --interval=30s --timeout=3s --start-period=15s --retries=3 \
  CMD node -e "fetch('http://127.0.0.1:3001/api/health/live').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"

CMD ["node", "apps/api/dist/main.js"]
